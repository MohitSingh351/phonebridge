<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>dev.phonebridge.mac</string>
    <key>CFBundleName</key><string>PhoneBridge</string>
    <key>CFBundleDisplayName</key><string>PhoneBridge</string>
    <key>CFBundleExecutable</key><string>PhoneBridge</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>LSMinimumSystemVersion</key><string>15.0</string>
    <!-- Menu-bar only: no Dock icon. -->
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <!-- Local Network privacy (macOS 15+): required to advertise and accept connections on the LAN. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>PhoneBridge listens on your local network so your paired phone can connect to this Mac directly, without any cloud service.</string>
    <key>NSBonjourServices</key>
    <array><string>_phonebridge._tcp</string></array>
</dict>
</plist>
