<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App names/icons for mirrored notifications. Android 11+ hides other apps by default; launcher apps
         (which is what posts notifications) can be declared without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Bound by the system only after the user grants Notification access in Settings. -->
        <service
            android:name=".NotifListener"
            android:exported="true"
            android:label="@string/notifications_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Only ordinary (alerting/silent) notifications; never ongoing ones. -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>
    </application>
</manifest>
